# Salin menjadi .env.local (lokal) atau isi sebagai environment di server. JANGAN commit nilai asli.

# Wajib saat instalasi production pertama (akun owner dibuat sekali, hanya jika database masih kosong).
# Password minimal 12 karakter. Setelah login pertama, ganti lewat menu Kelola > Akun.
OCCASIO_OWNER_EMAIL=
OCCASIO_OWNER_PASSWORD=

# Opsional: website publik (origin berbeda) yang boleh memanggil endpoint publik (form konsultasi, katalog).
# Pisahkan dengan koma, tulis lengkap dengan https://. Bawaan: http://127.0.0.1:4174,http://localhost:4174
# OCCASIO_PUBLIC_ORIGINS=https://domain-anda.com

# Opsional: folder unggahan foto/video/musik. Bawaan: data/uploads (relatif terhadap folder wedding-platform).
# Harus berada di disk permanen dan ikut dicadangkan.
# OCCASIO_UPLOAD_DIR=
